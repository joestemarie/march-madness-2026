[sqlfluff]
dialect = duckdb
templater = dbt
max_line_length = 120

[sqlfluff:templater:dbt]
project_dir = dbt_project
profiles_dir = dbt_project

[sqlfluff:rules]
# Leading commas
comma_style = leading

# Capitalisation
capitalisation_policy = lower
extended_capitalisation_policy = lower

[sqlfluff:rules:layout.commas]
# LT04: commas at the start of the line
line_position = leading
